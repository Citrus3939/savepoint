page {
  min-height: 100vh;
  background: #10131f;
  color: #f3ead7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 36rpx;
}

.panel {
  background: #1b2033;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.24);
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 16rpx;
  color: #c9bea8;
  line-height: 1.7;
  font-size: 28rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.primary-button {
  color: #191307;
  background: #f1c56b;
}

.secondary-button {
  color: #f3ead7;
  background: #2a314d;
}

.danger-button {
  color: #ffe7e7;
  background: #6b2932;
}

.muted {
  color: #9e9687;
}

.tag {
  display: inline-block;
  margin: 8rpx 8rpx 0 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(241, 197, 107, 0.16);
  color: #f1c56b;
  font-size: 24rpx;
}
