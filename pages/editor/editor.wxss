.form-card,
.list-card {
  margin-top: 28rpx;
}

.field-label,
.section-title {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  color: #f1c56b;
  font-size: 28rpx;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #10131f;
  color: #f3ead7;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  gap: 18rpx;
}

.half {
  flex: 1;
}

.small {
  flex: 1;
}

.event-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.event-title {
  color: #f3ead7;
  font-size: 29rpx;
  font-weight: 700;
}
