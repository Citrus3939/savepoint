.status {
  margin-bottom: 28rpx;
}

.age {
  color: #f1c56b;
  font-size: 42rpx;
  font-weight: 700;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #d8cfbd;
  font-size: 26rpx;
}

.talents {
  margin-top: 16rpx;
}

.mortality {
  margin-top: 18rpx;
  color: #ffb1a6;
  font-size: 25rpx;
}

.toast {
  margin-bottom: 28rpx;
